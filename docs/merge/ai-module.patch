index 0000000..e8a6cbe
--- /dev/null
+++ b/app/src/test/java/com/gia/aicomposer/AgreedThresholdsTest.kt
@@ -0,0 +1,87 @@
+package com.gia.aicomposer
+
+import com.gia.aicomposer.model.SceneState
+import com.gia.aicomposer.pipeline.CapturePipeline
+import com.gia.aicomposer.pipeline.FrameLockTracker
+import com.gia.aicomposer.pipeline.StabilityMonitor
+import com.gia.aicomposer.pipeline.shortestAngleDelta
+import com.gia.aicomposer.pose.PoseScorer
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * Chốt các ngưỡng đã thoả thuận (0.08 / 600 ms, 30° / 0.55, 15 dp / 1 s) ở dạng test.
+ *
+ * Đây là test "hợp đồng": nó không kiểm hành vi runtime (máy thật, cảm biến) mà bảo đảm
+ * một đợt refactor không âm thầm đổi con số. Hành vi hình học tương ứng được kiểm
+ * trong [com.gia.aicomposer.pipeline.FrameLockTrackerTest] và
+ * [com.gia.aicomposer.pipeline.StabilityMonitorContractTest].
+ *
+ * Các giá trị dưới đây là `const val` nên được inline lúc biên dịch; đổi số trong code
+ * sẽ làm test này đỏ ngay.
+ */
+class AgreedThresholdsTest {
+
+    @Test
+    fun motionStabilityIsGyro008OverTenEvaluations() {
+        assertEquals(0.08f, StabilityMonitor.GYRO_STILL_STD, 0f)
+        assertEquals(0.12f, StabilityMonitor.ACCEL_STILL_STD, 0f)
+        assertEquals(50L, StabilityMonitor.EVALUATION_INTERVAL_MS)
+        assertEquals(10, StabilityMonitor.REQUIRED_STILL_EVALUATIONS)
+        // Ngưỡng thoả thuận là 0.08 giữ ~600ms, nhưng spec gốc chốt "10 lần yên" × 50ms = 500ms.
+        // Test ghi nhận đúng số đang chạy; đổi REQUIRED_STILL_EVALUATIONS = 12 nếu muốn tròn 600ms.
+        assertEquals(500L, StabilityMonitor.EVALUATION_INTERVAL_MS * StabilityMonitor.REQUIRED_STILL_EVALUATIONS)
+        assertEquals(800L, StabilityMonitor.WINDOW_MS)
+        assertEquals(1.5f, StabilityMonitor.STRONG_SHAKE_ACCEL, 0f)
+        assertEquals(2.0f, StabilityMonitor.STRONG_SHAKE_GYRO, 0f)
+    }
+
+    @Test
+    fun driftIs30DegreesAt055Gain() {
+        assertEquals(30f, FrameLockTracker.MAX_DRIFT_ANGLE_DEG, 0f)
+        assertEquals(0.55f, FrameLockTracker.DRIFT_GAIN, 0f)
+        assertEquals(0.6f, FrameLockTracker.MIN_DISTANCE_FACTOR, 0f)
+        assertEquals(1.4f, FrameLockTracker.MAX_DISTANCE_FACTOR, 0f)
+        assertEquals(0.6f, FrameLockTracker.ZOOM_INFLUENCE, 0f)
+        assertEquals(0.25f, FrameLockTracker.DRIFT_LIMIT, 0f)
+    }
+
+    @Test
+    fun snapToCenterIs5to25Dp() {
+        assertEquals(5f, FrameLockTracker.SNAP_DEAD_ZONE_DP, 0f)
+        assertEquals(25f, FrameLockTracker.SNAP_FADE_END_DP, 0f)
+        assertEquals(0.9f, FrameLockTracker.SNAP_STRENGTH, 0f)
+    }
+
+    @Test
+    fun autoCaptureToleranceIs15DpHeldFor1s() {
+        assertEquals(15f, CapturePipeline.ALIGN_TOLERANCE_DP, 0f)
+        assertEquals(1_000L, CapturePipeline.ALIGN_HOLD_MS)
+        assertEquals(600L, CapturePipeline.MOTION_FALLBACK_MS)
+        assertEquals(2_500L, CapturePipeline.REGION_SEARCH_TIMEOUT_MS)
+    }
+
+    @Test
+    fun poseScoringWeightsUnchanged() {
+        assertEquals(2.0f, PoseScorer.MATCH_ENCOURAGED, 0f)
+        assertEquals(1.5f, PoseScorer.MATCH_REQUIRED, 0f)
+        assertEquals(1.5f, PoseScorer.FULL_BODY_NOT_ENOUGH_ROOM, 0f)
+        assertEquals(0.5f, PoseScorer.MIN_FULL_BODY_REGION, 0f)
+        assertEquals(1.5f, PoseScorer.HALF_BODY_BUSY_BONUS, 0f)
+        assertEquals(4.0f, PoseScorer.RECENT_PENALTY, 0f)
+        assertEquals(3, PoseScorer.RECENT_MEMORY)
+        assertEquals(0.5f, PoseScorer.VARIETY_BAND, 0f)
+        assertEquals(0.35f, SceneState.BUSY_CLUTTER_RATIO, 0f)
+    }
+
+    @Test
+    fun shortestAngleWrapsAtHalfTurn() {
+        // Đi qua điểm 0/360 phải đi đường ngắn, không nhảy 340°.
+        assertEquals(-20f, shortestAngleDelta(350f, 10f), 0.001f)
+        assertEquals(20f, shortestAngleDelta(10f, 350f), 0.001f)
+        // Giới hạn (-180, 180]: 190° phía dương quy về -170°.
+        assertEquals(-170f, shortestAngleDelta(190f, 0f), 0.001f)
+        assertEquals(180f, shortestAngleDelta(-180f, 0f), 0.001f)
+        assertEquals(0f, shortestAngleDelta(720f, 0f), 0.001f)
+    }
+}
diff --git a/app/src/test/java/com/gia/aicomposer/pipeline/FrameLockTrackerTest.kt b/app/src/test/java/com/gia/aicomposer/pipeline/FrameLockTrackerTest.kt
new file mode 100644
index 0000000..c1302f9
--- /dev/null
+++ b/app/src/test/java/com/gia/aicomposer/pipeline/FrameLockTrackerTest.kt
@@ -0,0 +1,193 @@
+package com.gia.aicomposer.pipeline
+
+import android.graphics.PointF
+import android.graphics.RectF
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * Hành vi của công thức trôi khung và hút tâm, tính bằng số cụ thể thay vì đọc hằng số:
+ * 30° → đúng 0.55 × cạnh ngắn, hút dính < 5 dp, hút dần 5–25 dp (hệ số 0.9), > 25 dp đứng yên.
+ *
+ * Toạ độ chuẩn hoá 0..1 theo `contentRect`; view 1080×1920, density 3 (1 dp = 3 px) nên
+ * 1 dp lệch tâm = 3 px = 3/1080 toạ độ chuẩn hoá.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class FrameLockTrackerTest {
+
+    private val density = 3f
+    private val viewWidth = 1080
+    private val viewHeight = 1920
+
+    /** FIT_CENTER khớp đúng aspect nên nội dung phủ kín view. */
+    private val content = RectF(0f, 0f, viewWidth.toFloat(), viewHeight.toFloat())
+
+    private fun tracker() = FrameLockTracker(density)
+
+    /** Khóa ở tâm rồi trả vị trí khung sau một lần cập nhật ở góc [yaw]. */
+    private fun driftAt(
+        yaw: Float,
+        distanceFactor: Float = 1f,
+        zoomRatio: Float = 1f,
+        basePosture: DevicePosture? = DevicePosture(0f, 0f, true),
+    ): PointF {
+        val tracker = tracker()
+        tracker.lock(
+            center = PointF(0.5f, 0.5f),
+            distanceFactor = distanceFactor,
+            zoomFactor = 1f,
+            posture = basePosture,
+            nowMs = 0L,
+        )
+        return tracker.update(
+            current = DevicePosture(yaw, 0f, true),
+            angularVelocityDegPerSec = 0f,
+            contentRect = content,
+            viewWidth = viewWidth,
+            viewHeight = viewHeight,
+            zoomRatio = zoomRatio,
+            nowMs = 33L,
+        ) ?: throw AssertionError("khung phải còn khóa")
+    }
+
+    @Test
+    fun thirtyDegreesMovesFrameExactly055OfShortSide() {
+        // 0.55 × 1080 px = 594 px = 0.55 toạ độ chuẩn hoá.
+        assertEquals(0.5f - 0.55f, driftAt(30f).x, 1e-4f)
+        assertEquals(0.5f, driftAt(30f).y, 1e-4f)
+    }
+
+    @Test
+    fun driftIsLinearInAngle() {
+        assertEquals(0.5f - 0.275f, driftAt(15f).x, 1e-4f)
+        assertEquals(0.5f + 0.275f, driftAt(-15f).x, 1e-4f)
+    }
+
+    @Test
+    fun driftStopsAtThirtyDegrees() {
+        val atThirty = driftAt(30f).x
+        assertEquals(atThirty, driftAt(90f).x, 1e-4f)
+        assertEquals(atThirty, driftAt(150f).x, 1e-4f)
+        assertEquals(atThirty, driftAt(-330f).x, 1e-4f)
+    }
+
+    @Test
+    fun driftDirectionFollowsScene() {
+        // Xoay phải (yaw tăng) làm cảnh trượt trái → khung bám sang trái.
+        assertEquals(-0.05f, driftAt(30f).x, 1e-4f)
+        assertEquals(1.05f, driftAt(-30f).x, 1e-4f)
+    }
+
+    @Test
+    fun distanceFactorScalesDrift() {
+        // Ở 15°: 0.55 × (15/30) × 0.6 = 0.165
+        assertEquals(0.5f - 0.165f, driftAt(15f, distanceFactor = 0.6f).x, 1e-4f)
+        // Ở 15°: 0.55 × (15/30) × 1.4 = 0.385
+        assertEquals(0.5f - 0.385f, driftAt(15f, distanceFactor = 1.4f).x, 1e-4f)
+    }
+
+    @Test
+    fun distanceFactorIsClampedAtLockTime() {
+        // Ngoài khoảng 0.6–1.4 bị kẹp, không cho khung trôi vô hạn.
+        assertEquals(driftAt(30f, distanceFactor = 1.4f).x, driftAt(30f, distanceFactor = 5f).x, 1e-4f)
+        assertEquals(driftAt(30f, distanceFactor = 0.6f).x, driftAt(30f, distanceFactor = 0f).x, 1e-4f)
+    }
+
+    @Test
+    fun zoomInfluencesDriftBy06() {
+        // zoom 2× → hệ số 1 + (2-1)×0.6 = 1.6; ở 10°: 0.55 × 1.6 × (10/30) = 0.29333
+        assertEquals(0.5f - 0.293333f, driftAt(10f, zoomRatio = 2f).x, 1e-4f)
+    }
+
+    @Test
+    fun withoutBasePostureThereIsNoDrift() {
+        // Cảm biến chưa có mốc lúc khóa: mẫu hợp lệ đầu tiên thành mốc, khung đứng yên.
+        assertEquals(0.5f, driftAt(30f, basePosture = null).x, 1e-4f)
+        assertEquals(0.5f, driftAt(30f, basePosture = DevicePosture(0f, 0f, false)).x, 1e-4f)
+    }
+
+    @Test
+    fun updateWithoutLockReturnsNull() {
+        assertNull(
+            tracker().update(
+                current = DevicePosture(10f, 0f, true),
+                angularVelocityDegPerSec = 0f,
+                contentRect = content,
+                viewWidth = viewWidth,
+                viewHeight = viewHeight,
+                zoomRatio = 1f,
+                nowMs = 33L,
+            ),
+        )
+    }
+
+    @Test
+    fun updateReturnsNullWhenContentRectIsEmpty() {
+        val tracker = tracker()
+        tracker.lock(PointF(0.5f, 0.5f), 1f, 1f, DevicePosture(0f, 0f, true), 0L)
+        assertNull(
+            tracker.update(
+                current = DevicePosture(10f, 0f, true),
+                angularVelocityDegPerSec = 0f,
+                contentRect = RectF(),
+                viewWidth = viewWidth,
+                viewHeight = viewHeight,
+                zoomRatio = 1f,
+                nowMs = 33L,
+            ),
+        )
+    }
+
+    @Test
+    fun driftIsCappedAtQuarterFrame() {
+        // distanceFactor 1.4 + zoom 2.5 → vượt biên; kết quả bị kẹp trong ±0.25.
+        val tracker = tracker()
+        tracker.lock(PointF(0.5f, 0.5f), 1.4f, 1f, DevicePosture(0f, 0f, true), 0L)
+        val point = tracker.update(
+            current = DevicePosture(30f, 0f, true),
+            angularVelocityDegPerSec = 0f,
+            contentRect = content,
+            viewWidth = viewWidth,
+            viewHeight = viewHeight,
+            zoomRatio = 3f,
+            nowMs = 33L,
+        )!!
+        assertEquals(-0.25f, point.x, 1e-4f)
+    }
+
+    @Test
+    fun frameInside5DpIsPulledExactlyToCenter() {
+        val snapped = tracker().snapToCenter(centerOffsetPx(4f), content, viewWidth, viewHeight)
+        assertEquals(0.5f, snapped.x, 1e-5f)
+        assertEquals(0.5f, snapped.y, 1e-5f)
+    }
+
+    @Test
+    fun frameAt15DpIsPulledPartially() {
+        // pull = 0.9 × (1 - (15-5)/20) = 0.45 → còn 55% độ lệch: 0.541666 → 0.522917
+        val before = centerOffsetPx(15f)
+        val snapped = tracker().snapToCenter(before, content, viewWidth, viewHeight)
+        assertEquals(0.5229167f, snapped.x, 1e-4f)
+        assertEquals(0.5f, snapped.y, 1e-5f)
+    }
+
+    @Test
+    fun frameAt25DpAndBeyondIsNotPulled() {
+        assertEquals(0.5694444f, tracker().snapToCenter(centerOffsetPx(25f), content, viewWidth, viewHeight).x, 1e-4f)
+        assertEquals(0.5833333f, tracker().snapToCenter(centerOffsetPx(30f), content, viewWidth, viewHeight).x, 1e-4f)
+    }
+
+    @Test
+    fun distanceFromCenterIsMeasuredInDp() {
+        assertEquals(15f, tracker().distanceFromCenterDp(centerOffsetPx(15f), content, viewWidth, viewHeight), 1e-4f)
+        assertEquals(0f, tracker().distanceFromCenterDp(PointF(0.5f, 0.5f), content, viewWidth, viewHeight), 1e-5f)
+    }
+
+    /** Tâm lệch [dp] dp sang phải so với tâm view, quy về toạ độ chuẩn hoá. */
+    private fun centerOffsetPx(dp: Float) = PointF(0.5f + dp * density / viewWidth, 0.5f)
+}
diff --git a/app/src/test/java/com/gia/aicomposer/pose/PoseScorerTest.kt b/app/src/test/java/com/gia/aicomposer/pose/PoseScorerTest.kt
new file mode 100644
index 0000000..40396fe
--- /dev/null
+++ b/app/src/test/java/com/gia/aicomposer/pose/PoseScorerTest.kt
@@ -0,0 +1,138 @@
+package com.gia.aicomposer.pose
+
+import android.graphics.RectF
+import com.gia.aicomposer.model.DepthBand
+import com.gia.aicomposer.model.SceneObject
+import com.gia.aicomposer.model.SceneState
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import kotlin.random.Random
+
+/**
+ * Chấm điểm dáng: +1.5/affordance bắt buộc, +2/affordance khuyến khích, −1.5 khi FULL_BODY
+ * không đủ chỗ (vùng trống cao < 0.5 khung), +1.5 cho HALF_BODY khi nền trước lộn xộn
+ * (> 35% khung), −4 khi dáng vừa xuất hiện trong 3 lần gần nhất.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class PoseScorerTest {
+
+    private val scorer = PoseScorer(FixedRandom())
+
+    private fun pose(id: String) = PoseLibrary.poses.first { it.id == id }
+
+    /** Cảnh có ghế; [openHeight] điều khiển vùng trống nên cũng điều khiển OPEN_GROUND. */
+    private fun chairScene(openHeight: Float = 1f, clutter: Float = 0f) = SceneState(
+        objects = listOf(
+            SceneObject(
+                label = "chair",
+                confidence = 0.9f,
+                box = RectF(0.1f, 0.4f, 0.4f, 0.8f),
+                depth = DepthBand.MID,
+                affordances = setOf(Affordance.CHAIR),
+            ),
+        ),
+        freeRegion = RectF(0f, 0f, 1f, openHeight),
+        nearClutterRatio = clutter,
+    )
+
+    private fun openScene(openHeight: Float = 1f, clutter: Float = 0f) = SceneState(
+        freeRegion = RectF(0f, 0f, 1f, openHeight),
+        nearClutterRatio = clutter,
+    )
+
+    @Test
+    fun requiredAffordanceIsWorthOneAndAHalf() {
+        val scored = scorer.score(pose("fb_sit_chair"), chairScene(), emptyList())
+        assertTrue(scored.eligible)
+        assertEquals(1.5f, scored.score, 1e-4f)
+    }
+
+    @Test
+    fun encouragedAffordanceIsWorthTwo() {
+        val scored = scorer.score(pose("fb_stand"), openScene(), emptyList())
+        assertTrue(scored.eligible)
+        assertEquals(2.0f, scored.score, 1e-4f)
+    }
+
+    @Test
+    fun fullBodyLosesPointsWhenOpenRegionIsUnderHalfFrame() {
+        assertEquals(0.5f, scorer.score(pose("fb_stand"), openScene(openHeight = 0.49f), emptyList()).score, 1e-4f)
+        // Đúng 0.5 khung vẫn còn đủ chỗ (ngưỡng là "< 0.5").
+        assertEquals(2.0f, scorer.score(pose("fb_stand"), openScene(openHeight = 0.5f), emptyList()).score, 1e-4f)
+    }
+
+    @Test
+    fun halfBodyIsNotPenalisedForLowOpenRegion() {
+        // 0.49 khung: vẫn có OPEN_GROUND nhưng dưới ngưỡng 0.5 của FULL_BODY.
+        assertEquals(0.5f, scorer.score(pose("fb_stand"), openScene(openHeight = 0.49f), emptyList()).score, 1e-4f)
+        assertEquals(2.0f, scorer.score(pose("hb_portrait"), openScene(openHeight = 0.49f), emptyList()).score, 1e-4f)
+    }
+
+    @Test
+    fun halfBodyGetsBonusOnBusyForeground() {
+        // 0.36 > 0.35 → lộn xộn.
+        assertEquals(3.5f, scorer.score(pose("hb_portrait"), openScene(clutter = 0.36f), emptyList()).score, 1e-4f)
+        // Đúng 0.35 không tính là lộn xộn.
+        assertEquals(2.0f, scorer.score(pose("hb_portrait"), openScene(clutter = 0.35f), emptyList()).score, 1e-4f)
+    }
+
+    @Test
+    fun recentPoseIsPenalised() {
+        assertEquals(-2.0f, scorer.score(pose("fb_stand"), openScene(), listOf("fb_stand")).score, 1e-4f)
+        assertEquals(2.0f, scorer.score(pose("fb_stand"), openScene(), listOf("a", "b")).score, 1e-4f)
+    }
+
+    @Test
+    fun onlyLastThreePicksAreRemembered() {
+        // fb_stand ở vị trí thứ 4 tính từ cuối → đã quên.
+        assertEquals(2.0f, scorer.score(pose("fb_stand"), openScene(), listOf("fb_stand", "a", "b", "c")).score, 1e-4f)
+        // Nằm trong 3 lần cuối → trừ 4 điểm.
+        assertEquals(-2.0f, scorer.score(pose("fb_stand"), openScene(), listOf("a", "b", "fb_stand")).score, 1e-4f)
+    }
+
+    @Test
+    fun missingRequiredAffordanceMakesPoseIneligible() {
+        val scored = scorer.score(pose("fb_lean_wall"), openScene(), emptyList())
+        assertFalse(scored.eligible)
+    }
+
+    @Test
+    fun suggestStaysInsideVarietyBandOfTheBestScore() {
+        val scene = chairScene()
+        val best = PoseLibrary.poses.maxOf { scorer.score(it, scene, emptyList()).score }
+        repeat(20) { seed ->
+            val suggestion = PoseScorer(Random(seed)).suggest(scene, emptyList())
+            assertTrue(
+                "gợi ý ${suggestion.pose.id} (${suggestion.score}) thấp hơn dải $VAR_BAND",
+                suggestion.score >= best - PoseScorer.VARIETY_BAND,
+            )
+            assertTrue(suggestion.score <= best)
+        }
+    }
+
+    @Test
+    fun suggestNeverReturnsPoseWithMissingRequiredAffordance() {
+        val scene = chairScene()
+        repeat(10) { seed ->
+            val suggestion = PoseScorer(Random(seed)).suggest(scene, emptyList())
+            assertTrue(
+                "dáng ${suggestion.pose.id} cần ${suggestion.pose.requiredAffordances}",
+                scene.affordances.containsAll(suggestion.pose.requiredAffordances),
+            )
+        }
+    }
+
+    private class FixedRandom : Random() {
+        override fun nextBits(bitCount: Int): Int = 0
+    }
+
+    private companion object {
+        const val VAR_BAND = 0.5f
+    }
+}
